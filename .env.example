# Required: any long random string. The app and MCP clients send it as a bearer token.
APP_ACCESS_KEY=
# Optional on first deploy: tokens printed by scripts/garmin_login.py (you can paste them in the app instead).
GARMIN_TOKENS=
# For the AI coach.
ANTHROPIC_API_KEY=
# Optional: coach model (default claude-sonnet-5-5).
COACH_MODEL=claude-sonnet-5-5
# Added automatically when you connect Upstash Redis in Vercel → Storage:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Run on generated sample data instead of a real account.
GARMIN_FAKE=0
